{
  "schemaVersion": 1,
  "name": "synthesis-skills-core",
  "displayName": "Synthesis: core",
  "version": "5.31.0",
  "description": "The ground every synthesis collection stands on: thinking and grounding discipline, verification before done, project records that survive compaction and restarts, decision packets and action sheets, the skill router, the skills that install synthesis and keep skill copies true to their source, and editing a knowledge base in the Open Knowledge Format, which each new workspace starts with. The core carries synthesis's guard, so every collection comes with it: the four hooks that hold sends, drafts and deploys for your approval and refuse destructive commands, and the runtime they run, with its board, approval codes and the rituals' records. Claude Code runs the hooks once installed; Codex and Muse once you approve them. The whole set, synthesis-skills, holds every skill in one plugin: https://github.com/synthesisengineering/synthesis-skills",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "synthesis-action-sheet",
        "path": "skills/synthesis-action-sheet/SKILL.md"
      },
      {
        "id": "synthesis-agent-guardrails",
        "path": "skills/synthesis-agent-guardrails/SKILL.md"
      },
      {
        "id": "synthesis-anti-shortcuts",
        "path": "skills/synthesis-anti-shortcuts/SKILL.md"
      },
      {
        "id": "synthesis-checkpoint",
        "path": "skills/synthesis-checkpoint/SKILL.md"
      },
      {
        "id": "synthesis-context-lifecycle",
        "path": "skills/synthesis-context-lifecycle/SKILL.md"
      },
      {
        "id": "synthesis-decision-packet",
        "path": "skills/synthesis-decision-packet/SKILL.md"
      },
      {
        "id": "synthesis-grounding-discipline",
        "path": "skills/synthesis-grounding-discipline/SKILL.md"
      },
      {
        "id": "synthesis-implementation-integrity",
        "path": "skills/synthesis-implementation-integrity/SKILL.md"
      },
      {
        "id": "synthesis-kb-edit",
        "path": "skills/synthesis-kb-edit/SKILL.md"
      },
      {
        "id": "synthesis-model-tiers",
        "path": "skills/synthesis-model-tiers/SKILL.md"
      },
      {
        "id": "synthesis-okf",
        "path": "skills/synthesis-okf/SKILL.md"
      },
      {
        "id": "synthesis-onboarding",
        "path": "skills/synthesis-onboarding/SKILL.md"
      },
      {
        "id": "synthesis-project-management",
        "path": "skills/synthesis-project-management/SKILL.md"
      },
      {
        "id": "synthesis-skill-router",
        "path": "skills/synthesis-skill-router/SKILL.md"
      },
      {
        "id": "synthesis-skills-manager",
        "path": "skills/synthesis-skills-manager/SKILL.md"
      },
      {
        "id": "synthesis-thinking-framework",
        "path": "skills/synthesis-thinking-framework/SKILL.md"
      },
      {
        "id": "synthesis-tree-of-thought",
        "path": "skills/synthesis-tree-of-thought/SKILL.md"
      }
    ],
    "commands": [],
    "hooks": [
      {
        "id": "synthesis-session-start",
        "event": "SessionStart",
        "command": [
          "/bin/sh",
          ".muse-plugin/hooks/session-start.sh"
        ],
        "timeoutMs": 10000,
        "statusMessage": "Loading the active synthesis project"
      },
      {
        "id": "synthesis-user-prompt-submit",
        "event": "UserPromptSubmit",
        "command": [
          "/bin/sh",
          ".muse-plugin/hooks/user-prompt-submit.sh"
        ],
        "timeoutMs": 5000
      },
      {
        "id": "synthesis-pre-tool-use",
        "event": "PreToolUse",
        "command": [
          "/bin/sh",
          ".muse-plugin/hooks/pre-tool-use.sh"
        ],
        "timeoutMs": 5000
      },
      {
        "id": "synthesis-stop",
        "event": "Stop",
        "command": [
          "/bin/sh",
          ".muse-plugin/hooks/stop.sh"
        ],
        "timeoutMs": 10000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
