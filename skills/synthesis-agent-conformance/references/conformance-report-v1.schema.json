{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthesisengineering.org/schemas/conformance-report/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "schema_sha256",
    "checked_at",
    "expires_at",
    "command",
    "identity",
    "ok",
    "status",
    "planes",
    "checks"
  ],
  "properties": {
    "schema_id": {
      "const": "https://synthesisengineering.org/schemas/conformance-report/v1"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine_sha256",
        "source_root",
        "source_binding_sha256",
        "producer_sha256",
        "project",
        "repo_root",
        "profile"
      ],
      "properties": {
        "machine_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_binding_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "producer_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "project": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "repo_root": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "enum": [
            "public",
            "private"
          ]
        }
      }
    },
    "ok": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "planes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "installed",
        "native",
        "continuity",
        "capability"
      ],
      "properties": {
        "source": {
          "enum": [
            "PASS",
            "FAIL",
            "WARN",
            "UNKNOWN",
            "UNSUPPORTED"
          ]
        },
        "installed": {
          "enum": [
            "PASS",
            "FAIL",
            "WARN",
            "UNKNOWN",
            "UNSUPPORTED"
          ]
        },
        "native": {
          "enum": [
            "PASS",
            "FAIL",
            "WARN",
            "UNKNOWN",
            "UNSUPPORTED"
          ]
        },
        "continuity": {
          "enum": [
            "PASS",
            "FAIL",
            "WARN",
            "UNKNOWN",
            "UNSUPPORTED"
          ]
        },
        "capability": {
          "enum": [
            "PASS",
            "FAIL",
            "WARN",
            "UNKNOWN",
            "UNSUPPORTED"
          ]
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "ok",
          "detail",
          "required",
          "plane",
          "outcome",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "ok": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 16384
          },
          "required": {
            "type": "boolean"
          },
          "plane": {
            "enum": [
              "source",
              "installed",
              "native",
              "continuity",
              "capability"
            ]
          },
          "outcome": {
            "anyOf": [
              {
                "enum": [
                  "PASS",
                  "FAIL",
                  "WARN",
                  "UNKNOWN",
                  "UNSUPPORTED"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "WARN",
              "UNKNOWN",
              "UNSUPPORTED"
            ]
          }
        }
      }
    }
  }
}
