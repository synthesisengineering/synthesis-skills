{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthesisengineering.org/schemas/invite-v1.json",
  "title": "Synthesis organization enrollment invite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "provider", "manifest_path", "nonce", "issued_at", "expires_at"],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"type": "string", "minLength": 1},
    "provider": {"enum": ["github", "gitlab", "bitbucket", "generic"]},
    "manifest_path": {"const": ".agents/onboarding.yaml"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "display_name": {"type": "string", "maxLength": 120},
    "auth_help_url": {"type": "string", "pattern": "^https://"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
