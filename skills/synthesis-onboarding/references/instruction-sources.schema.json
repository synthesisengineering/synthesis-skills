{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthesisengineering.org/schemas/instruction-sources-v1.json",
  "title": "Synthesis tracked workspace instruction graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources", "output", "claude_adapter"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "allOf": [
        {"contains": {"type": "object", "properties": {"role": {"const": "public"}}, "required": ["role"]}, "minContains": 0, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"role": {"const": "organization"}}, "required": ["role"]}, "minContains": 0, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"role": {"const": "personal"}}, "required": ["role"]}, "minContains": 0, "maxContains": 1}
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path"],
        "properties": {
          "role": {"enum": ["public", "organization", "personal"]},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
          "required": {"type": "boolean"}
        }
      }
    },
    "output": {"const": "AGENTS.md"},
    "claude_adapter": {"const": "CLAUDE.md"}
  }
}
