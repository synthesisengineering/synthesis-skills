{
  "schema_version": 1,
  "owner": "synthesis-onboarding/runtime_payload.py",
  "console_owner": "synthesis-console/scripts/service-ownership.ts",
  "platforms": {
    "macos": {
      "runtime_supported": true,
      "path_style": "posix",
      "console_manager": "launchd-user",
      "console_unit": "{home}/Library/LaunchAgents/org.synthesisengineering.console.plist",
      "console_label": "org.synthesisengineering.console",
      "console_python": "{data}/synthesis-console/python-runtime",
      "console_receipt": "{state}/synthesis-console/autostart.json",
      "console_retirement": "{state}/synthesis-console/autostart-uninstall.json",
      "console_logs": "{home}/Library/Logs/synthesis-console",
      "service_requires": "Aqua login user domain; matching receipt and actual manager evidence",
      "day_end_service": "{home}/Library/LaunchAgents/com.synthesis.day-end-nudge.plist",
      "live_qualification": "UNVERIFIED"
    },
    "linux": {
      "runtime_supported": true,
      "path_style": "posix",
      "console_manager": "systemd-user",
      "console_unit": "{config}/systemd/user/synthesis-console.service",
      "console_label": "synthesis-console.service",
      "console_python": "{data}/synthesis-console/python-runtime",
      "console_receipt": "{state}/synthesis-console/autostart.json",
      "console_retirement": "{state}/synthesis-console/autostart-uninstall.json",
      "console_logs": "journald:user:synthesis-console.service",
      "service_requires": "Running systemd user manager; matching receipt and actual manager evidence; lingering is never enabled automatically",
      "day_end_service": null,
      "live_qualification": "UNVERIFIED"
    },
    "wsl": {
      "runtime_supported": true,
      "path_style": "posix",
      "console_manager": "systemd-user",
      "console_unit": "{config}/systemd/user/synthesis-console.service",
      "console_label": "synthesis-console.service",
      "console_python": "{data}/synthesis-console/python-runtime",
      "console_receipt": "{state}/synthesis-console/autostart.json",
      "console_retirement": "{state}/synthesis-console/autostart-uninstall.json",
      "console_logs": "journald:user:synthesis-console.service",
      "service_requires": "Linux userland within WSL2 with systemd user manager verified; Windows Task Scheduler is not the owner; no Windows or WSL boot settings are changed",
      "day_end_service": null,
      "live_qualification": "UNVERIFIED"
    },
    "native-windows": {
      "runtime_supported": false,
      "path_style": "windows",
      "console_manager": null,
      "console_unit": null,
      "console_label": null,
      "console_python": null,
      "console_receipt": null,
      "console_retirement": null,
      "console_logs": null,
      "service_requires": "UNSUPPORTED: native Windows has no qualified service/runtime owner. WSL is a separate Linux installation with its own home and identity. No Task Scheduler or Windows Service registration is created.",
      "day_end_service": null,
      "live_qualification": "UNSUPPORTED"
    }
  },
  "runtime_paths": {
    "git-hooks": "{home}/.synthesis/git-hooks",
    "message-guard": "{home}/.synthesis/message-guard",
    "kernel": "{engine_state}/bin",
    "day-end": "{home}/.synthesis/day-end/bin"
  },
  "permissions": {
    "ownership_receipt_mode": 384,
    "private_directory_mode": 448,
    "unknown_files": "preserve and refuse",
    "repair_authority": "Exact existing owner receipt and explicit selected operation; mapping or diagnosis never authorizes mutation."
  }
}
