{
  "schema_version": 1,
  "product": "synthesis-work-system",
  "release_identity_source": ".codex-plugin/plugin.json",
  "cli": {
    "name": "synthesis",
    "commands": [
      "setup",
      "enroll",
      "stage-core",
      "activate",
      "deactivate",
      "update",
      "repair",
      "status",
      "doctor",
      "workspace ensure",
      "outcome verify",
      "uninstall"
    ]
  },
  "modalities": [
    "agent",
    "terminal"
  ],
  "profiles": {
    "full": {
      "primary": true,
      "bootstrap_arguments": [
        "setup",
        "--profile",
        "full"
      ],
      "selected_layers": [
        "skills",
        "session-context",
        "hooks-gates",
        "agent-kernel",
        "runtime-engines",
        "coordination",
        "doctors-conformance",
        "personal-policy",
        "knowledge-bases",
        "lifecycle"
      ],
      "conditional_layers": [
        "organization"
      ]
    },
    "skills-only": {
      "primary": false,
      "bootstrap_arguments": [
        "setup",
        "--profile",
        "skills-only"
      ],
      "selected_layers": [
        "skills",
        "session-context",
        "lifecycle"
      ],
      "conditional_layers": [
        "organization"
      ]
    },
    "modular": {
      "primary": false,
      "bootstrap_arguments": [
        "setup",
        "--profile",
        "modular"
      ],
      "conditional_layers": [],
      "selected_layers": [
        "skills",
        "lifecycle"
      ]
    }
  },
  "release_policy": {
    "default_channel": "stable",
    "channels": {
      "stable": "stable",
      "edge": "main"
    },
    "exact_pin_format": "vX.Y.Z",
    "automatic_updates": false,
    "trust": [
      "authenticated-https",
      "immutable-tag",
      "commit",
      "git-tree",
      "sha256-tree-v1"
    ]
  },
  "platforms": {
    "supported": [
      "macos",
      "linux",
      "wsl"
    ],
    "unsupported": [
      "windows-native"
    ]
  },
  "clients": [
    "claude",
    "codex"
  ],
  "truth_planes": [
    "desired",
    "resolved",
    "installed",
    "source-provenance",
    "live-loaded",
    "outcome-verified"
  ],
  "layers": [
    {
      "id": "skills",
      "title": "Skills",
      "description": "Portable synthesis methods loaded through a native plugin or direct-copy fallback."
    },
    {
      "id": "session-context",
      "title": "Session context",
      "description": "SessionStart time, project, coordination, and lifecycle evidence."
    },
    {
      "id": "hooks-gates",
      "title": "Hooks and gates",
      "description": "Commit-boundary and pre-send controls running from stable local paths."
    },
    {
      "id": "agent-kernel",
      "title": "Agent kernel",
      "description": "One Git-tracked instruction source exposed to both supported clients."
    },
    {
      "id": "runtime-engines",
      "title": "Runtime engines",
      "description": "Durable local engines and launchers under the synthesis state root."
    },
    {
      "id": "coordination",
      "title": "Coordination",
      "description": "Lease-aware session claims, messages, and handoff machinery."
    },
    {
      "id": "doctors-conformance",
      "title": "Doctors and conformance",
      "description": "Health checks that distinguish defects from unverifiable state."
    },
    {
      "id": "personal-policy",
      "title": "Personal policy",
      "description": "User-authored preferences, guard patterns, and routing policy."
    },
    {
      "id": "organization",
      "title": "Organization",
      "description": "Optional declarative organization configuration and knowledge access."
    },
    {
      "id": "knowledge-bases",
      "title": "Knowledge bases",
      "description": "Git-backed personal and optional organization knowledge repositories."
    },
    {
      "id": "lifecycle",
      "title": "Lifecycle",
      "description": "Release policy, update notice, reconciliation, and receipts."
    }
  ],
  "manifest_schema_version": 2,
  "state_schema_version": 1,
  "observation_schema_version": 3,
  "invite_schema_version": 1,
  "instruction_sources_schema_version": 1,
  "instruction_source": "ai-knowledge-{workspace}/.agents/workspace-AGENTS.md",
  "organization_instruction_graph": {
    "roles": [
      "public",
      "organization",
      "personal"
    ],
    "personal_role": "optional-user-local-desired-state",
    "existing_output_adoption": "explicit-archive-first"
  },
  "restart_rule": "Update is the initiating task's last action; a fresh client lifecycle receipt establishes live-loaded state.",
  "public_acceptance_tasks": [
    {
      "id": "workspace-grounding-check",
      "capability": "workspace-read",
      "source_class": "personal-knowledge"
    }
  ],
  "distribution": {
    "schema_version": 1,
    "bootstrap": {
      "url": "https://raw.githubusercontent.com/synthesisengineering/synthesis-skills/v4.101.0/onboard.sh",
      "release": "4.101.0",
      "sha256": "4199dea8389fe401d8e1f27622875daf3bf1e5961c6a28194128a39037721261",
      "source_url": "https://github.com/synthesisengineering/synthesis-skills/blob/v4.101.0/onboard.sh",
      "short_url": "https://synthesisengineering.org/onboard.sh",
      "short_url_verified": false
    },
    "channels": {
      "brew": {
        "status": "pending",
        "package": "synthesisengineering/tap/synthesis",
        "install": [
          "brew install synthesisengineering/tap/synthesis",
          "synthesis setup --profile {profile}"
        ],
        "platforms": [
          "macos",
          "linux"
        ],
        "evidence_url": null
      },
      "npm": {
        "status": "pending",
        "package": "@synthesiswork/synthesis",
        "install": [
          "npm install -g @synthesiswork/synthesis",
          "synthesis setup --profile {profile}"
        ],
        "platforms": [
          "macos",
          "linux",
          "wsl"
        ],
        "evidence_url": null
      },
      "bun": {
        "status": "pending",
        "package": "@synthesiswork/synthesis",
        "install": [
          "bun add -g @synthesiswork/synthesis",
          "synthesis setup --profile {profile}"
        ],
        "platforms": [
          "macos",
          "linux",
          "wsl"
        ],
        "evidence_url": null
      }
    },
    "deferred_channels": {
      "paru": {
        "reason": "AUR account registration is temporarily closed; excluded by user direction from this release.",
        "status": "deferred"
      }
    },
    "official_npm_scopes": [
      "@synthesiswork"
    ],
    "modular": {
      "status": "pending",
      "release": null,
      "inventory_source": "skills/synthesis-onboarding/references/components.json",
