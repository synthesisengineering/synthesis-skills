{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthesisengineering.org/schemas/machine-observation-v1.json",
  "title": "Synthesis machine observation and transaction receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generation", "transactions"],
  "properties": {
    "schema_version": {"const": 3},
    "generation": {"type": "integer", "minimum": 0},
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transaction_id",
          "generation",
          "state",
          "command",
          "desired_digest",
          "started_at"
        ],
        "properties": {
          "transaction_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
          "generation": {"type": "integer", "minimum": 1},
          "state": {"enum": ["pending", "committed", "aborted"]},
          "command": {"enum": ["setup", "enroll", "update", "repair", "workspace-ensure", "uninstall"]},
          "desired_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "committed_desired_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "release": {"$ref": "release-descriptor.schema.json"},
          "previous_active_generation": {"type": ["integer", "null"], "minimum": 1},
          "desired": {"type": "object"},
          "resolved": {"type": "object"},
          "installed": {"type": "object"},
          "source-provenance": {"type": "object"},
          "live-loaded": {"type": "object"},
          "outcome-verified": {"type": "object"},
          "instruction_receipt": {"type": "object"},
          "details": {"type": "object"},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "error": {"type": "string"}
        }
      }
    }
  }
}
