{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synthesis:review:target:1",
  "title": "Review target",
  "description": "Interchange shape only; production validator and effect owner are mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domain",
    "principal_objective",
    "files",
    "planes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "domain": {
      "enum": [
        "editorial",
        "code/control",
        "research",
        "operations/compliance"
      ]
    },
    "principal_objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "planes": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
      }
    }
  }
}
