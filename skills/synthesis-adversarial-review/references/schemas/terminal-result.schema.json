{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synthesis:review:terminal-result:1",
  "title": "Review terminal-result",
  "description": "Interchange shape only; production validator and effect owner are mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "target",
    "destination",
    "phase",
    "status",
    "evidence",
    "approval",
    "artifact",
    "plane"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "destination": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "phase": {
      "enum": [
        "content",
        "control",
        "platform",
        "publication"
      ]
    },
    "status": {
      "enum": [
        "verified",
        "failed",
        "unverified",
        "not-authorized"
      ]
    },
    "evidence": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
      }
    },
    "approval": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "plane": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    }
  }
}
