{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synthesis:review:handoff:1",
  "title": "Review handoff",
  "description": "Interchange shape only; production validator and effect owner are mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "target",
    "target_digest",
    "reviewer",
    "evidence",
    "links"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "target_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "evidence": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
      }
    },
    "links": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      }
    }
  }
}
