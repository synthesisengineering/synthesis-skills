{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synthesis:review:claim:1",
  "title": "Review claim",
  "description": "Interchange shape only; production validator and effect owner are mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "target",
    "plane",
    "text",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "plane": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "evidence": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
      }
    }
  }
}
