{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synthesis:review:decision:1",
  "title": "Review decision",
  "description": "Interchange shape only; production validator and effect owner are mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "target",
    "owner_receipt",
    "target_digest",
    "action",
    "approver",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "owner_receipt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "target_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "action": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "approver": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "evidence": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
      }
    }
  }
}
